{
  "name": "one-burger-commerce",
  "version": "1.0.0",
  "description": "Menu and pickup ordering platform for One Burger.",
  "scripts": {
    "prebuild": "node scripts/check-build-env.mjs --strict-production",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:production": "node scripts/start-production.mjs",
    "lint": "eslint .",
    "security:secrets": "node scripts/check-no-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test tests/e2e/production-smoke.spec.ts",
    "test:e2e:prod:full": "playwright test tests/e2e",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "deploy:easypanel": "node scripts/easypanel-deploy.mjs",
    "deploy:easypanel:dry-run": "node scripts/easypanel-deploy.mjs --dry-run",
    "deploy:easypanel:preflight": "node scripts/easypanel-deploy.mjs --preflight"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.24.0",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
