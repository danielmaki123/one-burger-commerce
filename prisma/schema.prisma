generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  owner
  manager
  kitchen
  /// TASK-105 — cobra en el punto de venta. No administra menú, promociones ni configuración.
  cashier
}

model AdminUser {
  id           String              @id @default(cuid())
  name         String
  email        String              @unique
  passwordHash String
  role         AdminRole
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sessions     AdminSession[]
  locations    AdminUserLocation[]
  /// TASK-104 — los turnos de caja que abrió y cerró este usuario.
  shifts       Shift[]
  /// Bloque 2 del POS — los movimientos de caja que registró.
  cashMovements CashMovement[]
}

/// Sucursales que puede ver un usuario del staff (A). El `owner` ve todas y su asignación se
/// ignora; un gerente o cocina **sin filas acá** también ve todas (el deploy no deja a nadie
/// ciego). Borrar el local o el usuario borra la asignación en cascada.
model AdminUserLocation {
  adminUserId String
  locationId  String
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([adminUserId, locationId])
  @@index([locationId])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id                 String            @id @default(cuid())
  fullName           String?
  whatsappNormalized String            @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  orders             Order[]
  reservations       Reservation[]
  addresses          CustomerAddress[]
  sessions           CustomerSession[]
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String?
  address    String
  reference  String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isDefault])
}

model CustomerOtp {
  id                 String    @id @default(cuid())
  whatsappNormalized String
  codeHash           String
  expiresAt          DateTime
  attempts           Int       @default(0)
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([whatsappNormalized, createdAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  /// Color de la categoría en la carta pública (`#rrggbb`). Vacío = sin color.
  color         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  slug       String
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Product {
  id                 String                 @id @default(cuid())
  categoryId         String
  subcategoryId      String?
  name               String
  description        String?
  basePrice          Decimal                @db.Decimal(10, 2)
  packagingFeeAmount Decimal?               @db.Decimal(10, 2)
  sortOrder          Int                    @default(0)
  isAvailable        Boolean                @default(true)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  category           Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory        Subcategory?           @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  modifierGroups     ProductModifierGroup[]
  bundleRules        BundleRule[]
  locations          LocationProduct[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive])
}

/// Un local del negocio (T8). Lo que es por local: dónde se retira, contacto, horario,
/// minutos de preparación y si acepta pedidos. La marca, la moneda y las promos siguen
/// siendo del negocio entero y viven en `BusinessSettings`.
model Location {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  isActive          Boolean             @default(true)
  /// Orden manual; el primero activo es el local por defecto.
  sortOrder         Int                 @default(0)
  addressLine       String?
  city              String?
  addressReference  String?
  mapsUrl           String?
  latitude          Float?
  longitude         Float?
  phone             String?
  whatsapp          String?
  businessHours     Json
  pickupLeadMinutes Int                 @default(25)
  /// Máximo del rango de preparación (`null` = se promete un instante, no una franja).
  pickupMaxMinutes  Int?
  /// B5: minutos que puede esperar un pedido **sin aceptar** antes de avisar en el tablero de comandas.
  acceptAlertMinutes Int                @default(10)
  /// B5: minutos que puede estar un pedido **en cocina** (aceptado, preparando o listo) antes de avisar.
  prepAlertMinutes   Int                @default(15)
  isAcceptingOrders Boolean             @default(true)
  /// TASK-308 — si este local usa el punto de venta (mostrador). Nace prendido para no cambiarle
  /// nada al negocio de un solo local; apagado, la API del POS responde 403 en ese local.
  posEnabled        Boolean             @default(true)
  /// Tarea 3 del brief (2026-09-17) — cierre **obligatorio** de caja en este local: la caja no puede
  /// quedar abierta de un día para el otro. Nace apagado (cada sucursal lo decide desde su ficha); si
  /// está prendido y la caja sigue abierta con fecha de otro día, el POS no deja cobrar hasta cerrarla.
  requireShiftClose Boolean             @default(false)
  closedMessage     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  products          LocationProduct[]
  orders            Order[]
  adminUsers        AdminUserLocation[]
  /// TASK-104 — los turnos de caja de este local.
  shifts            Shift[]
  /// Tarea 7 del brief (2026-09-17) — los traspasos de caja firmados en este local.
  shiftHandovers    ShiftHandover[]

  @@index([isActive, sortOrder])
}

/// Qué ofrece cada local y a qué precio (T8). Sin fila acá, el producto no se vende en
/// ese local; `priceOverride` en `null` significa "el precio base del producto".
model LocationProduct {
  id            String   @id @default(cuid())
  locationId    String
  productId     String
  priceOverride Decimal? @db.Decimal(10, 2)
  isAvailable   Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ModifierGroup {
  id            String                 @id @default(cuid())
  name          String
  isRequired    Boolean                @default(false)
  minSelections Int                    @default(0)
  maxSelections Int                    @default(1)
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  options       ModifierOption[]
  products      ProductModifierGroup[]
}

model ModifierOption {
  id              String        @id @default(cuid())
  modifierGroupId String
  name            String
  priceDelta      Decimal       @db.Decimal(10, 2)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
}

model ProductModifierGroup {
  id              String        @id @default(cuid())
  productId       String
  modifierGroupId String
  sortOrder       Int           @default(0)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@index([productId])
  @@index([modifierGroupId])
}

model BundleRule {
  id        String   @id @default(cuid())
  productId String
  name      String
  ruleType  String   @default("fixed")
  config    Json     @default("{}")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum MenuMarketingBlockType {
  promo
  event
  combo
  featured
  info
}

enum MenuMarketingBlockCtaType {
  none
  product
  category
  url
}

model MenuMarketingBlock {
  id          String                    @id @default(cuid())
  type        MenuMarketingBlockType
  title       String
  description String?
  imageUrl    String?
  ctaLabel    String?
  ctaType     MenuMarketingBlockCtaType @default(none)
  ctaTarget   String?
  isActive    Boolean                   @default(true)
  sortOrder   Int                       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

enum OrderType {
  delivery
  pickup
  table
}

/// Cómo piensa pagar el cliente (T11). El cobro sigue siendo en el local.
enum PaymentMethod {
  cash
  card
}

/// TASK-103 — los métodos que acepta un **cobro registrado**. Es más amplio que `PaymentMethod`
/// (que declara el cliente en el checkout y sigue existiendo por compatibilidad): acá entran la
/// transferencia, el pago mixto y "otro", que son cosas que pasan en el mostrador.
enum PaymentMethodType {
  cash
  card
  transfer
  mixed
  other
}

/// TASK-104 — un turno de caja, abierto y cerrado.
enum ShiftStatus {
  open
  closed
}

enum OrderStatus {
  new
  confirmed
  preparing
  ready
  out_for_delivery
  delivered
  closed
  ready_for_pickup
  picked_up
  accepted
  served
  cancelled
}

enum CouponType {
  percentage
  fixed_amount
  /// Promo por cantidad (T9): usá `buyQuantity` y `freeQuantity`.
  bogo
}

model Table {
  id           String        @id @default(cuid())
  label        String
  qrToken      String        @unique
  isActive     Boolean       @default(true)
  locationId   String        @default("main")
  capacity     Int           @default(4)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  reservations Reservation[]
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  value        Decimal    @db.Decimal(10, 2)
  isActive     Boolean    @default(true)
  usageLimit   Int        @default(0)
  usedCount    Int        @default(0)
  expiresAt    DateTime?
  /// Promo por cantidad (T9): cuántas unidades hay que llevar y cuántas salen gratis.
  buyQuantity  Int?
  freeQuantity Int?
  /// A qué alcanza: `all`, `category`, `subcategory` o `product`, con su id.
  scopeType    String?    @default("all")
  scopeId      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
}

model DeliveryZone {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  baseFee     Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id                   String               @id @default(cuid())
  orderNumber          String               @unique
  /// Local al que va el pedido (T8). Obligatorio: la migración backfillea los pedidos
  /// que ya existían al local primario.
  locationId           String
  orderLookupTokenHash String?
  /// TASK-101: clave de operación del cliente. El alta pública no tiene sesión, así que un
  /// reintento del mismo request (doble tap, red que se corta) creaba **otro pedido**. Nullable
  /// porque los pedidos que ya existían y los que llegan sin clave no tienen ninguna.
  idempotencyKey       String?              @unique
  type                 OrderType
  status               OrderStatus          @default(new)
  customerName         String
  customerWhatsapp     String
  /// TASK-303b — correo del cliente, **opcional** (lo pidió el owner para la venta de mostrador).
  customerEmail        String?
  customerId           String?
  address              String?
  deliveryNotes        String?
  deliveryFeeStatus    String?              @default("pending_manual_validation")
  deliveryFeeAmount    Decimal              @default(0) @db.Decimal(10, 2)
  pickupTime           DateTime?
  /// Si el cliente programó el retiro. `false` = lo antes posible: el servidor guarda
  /// igual una `pickupTime` concreta (ahora + preparación) para que la cocina sepa para
  /// cuándo es, pero la distinción se conserva para poder marcarlo en el admin.
  pickupScheduled      Boolean              @default(false)
  pickupNotes          String?
  tableId              String?
  /// Forma de pago declarada por el cliente (informativa para la caja).
  paymentMethod        PaymentMethod        @default(cash)
  /// Con cuánto paga el cliente, para calcular el vuelto en la caja (T12).
  paidWithAmount       Decimal?             @db.Decimal(10, 2)
  /// Código corto para dictar en caja (T13). No identifica ni autoriza: eso es
  /// `orderNumber` + `orderLookupTokenHash`.
  pickupPin            String?
  couponId             String?
  couponCode           String?
  subtotal             Decimal              @db.Decimal(10, 2)
  discount             Decimal              @default(0) @db.Decimal(10, 2)
  packagingAmount      Decimal              @default(0) @db.Decimal(10, 2)
  tipAmount            Decimal              @default(0) @db.Decimal(10, 2)
  tipRate              Decimal?             @db.Decimal(5, 2)
  total                Decimal              @db.Decimal(10, 2)
  deliveryZoneId       String?
  customerLat          Decimal?             @db.Decimal(10, 8)
  customerLng          Decimal?             @db.Decimal(10, 8)
  geoAccuracy          Float?
  geoCapturedAt        DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  table                Table?               @relation(fields: [tableId], references: [id], onDelete: SetNull)
  location             Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  coupon               Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  customer             Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryZone         DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  /// TASK-103 — los cobros registrados de este pedido (uno por pago; el mixto tiene varios).
  payments             Payment[]
  /// Bloque 3 del POS — las devoluciones de este pedido. Cuelgan de la orden además del cobro para
  /// poder listar "qué se le devolvió a este pedido" sin pasar por los pagos.
  refunds              Refund[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([locationId])
  @@index([pickupTime])
  @@index([tableId])
  @@index([couponId])
  @@index([customerId])
  @@index([deliveryZoneId])
}

model OrderItem {
  id                   String              @id @default(cuid())
  orderId              String
  productId            String
  productName          String
  quantity             Int
  unitPrice            Decimal             @db.Decimal(10, 2)
  packagingUnitAmount  Decimal             @default(0) @db.Decimal(10, 2)
  packagingQuantity    Int                 @default(0)
  packagingTotalAmount Decimal             @default(0) @db.Decimal(10, 2)
  notes                String?
  lineTotal            Decimal             @db.Decimal(10, 2)
  createdAt            DateTime            @default(now())
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers            OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemModifier {
  id               String    @id @default(cuid())
  orderItemId      String
  modifierOptionId String
  name             String
  priceDelta       Decimal   @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  /// B5: quién hizo el cambio (id del usuario del panel). Sin FK a propósito: borrar una cuenta no
  /// puede borrar ni romper el historial de lo que pasó con los pedidos.
  changedByUserId String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

enum ReservationStatus {
  requested
  approved
  rejected
  seated
  cancelled
  no_show
}

model Reservation {
  id                         String            @id @default(cuid())
  status                     ReservationStatus @default(requested)
  customerName               String
  customerWhatsapp           String
  customerId                 String?
  reservationNumber          String?           @unique
  reservationLookupTokenHash String?
  date                       String
  time                       String
  partySize                  Int
  tableId                    String
  tableLabel                 String
  notes                      String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  table                      Table             @relation(fields: [tableId], references: [id])
  customer                   Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([date])
  @@index([tableId])
  @@index([customerId])
}

enum OutboxStatus {
  pending
  processing
  processed
  failed
}

model InventoryItem {
  id                    String                   @id @default(cuid())
  name                  String
  unit                  String
  category              String
  currentEstimatedStock Decimal                  @db.Decimal(10, 3)
  lowStockThreshold     Decimal                  @db.Decimal(10, 3)
  isActive              Boolean                  @default(true)
  locationId            String                   @default("main")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  counts                InventoryCount[]
  wasteRecords          InventoryWasteRecord[]
  receiveRecords        InventoryReceiveRecord[]

  @@index([isActive])
  @@index([locationId])
}

model InventoryCount {
  id              String        @id @default(cuid())
  inventoryItemId String
  countedQuantity Decimal       @db.Decimal(10, 3)
  countedByUserId String
  countedAt       DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([countedAt])
}

model InventoryWasteRecord {
  id               String        @id @default(cuid())
  inventoryItemId  String
  quantity         Decimal       @db.Decimal(10, 3)
  reason           String
  reportedByUserId String
  reportedAt       DateTime      @default(now())
  notes            String?
  createdAt        DateTime      @default(now())
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([reportedAt])
}

model InventoryReceiveRecord {
  id               String        @id @default(cuid())
  inventoryItemId  String
  receivedQuantity Decimal       @db.Decimal(10, 3)
  receivedByUserId String
  receivedAt       DateTime      @default(now())
  notes            String?
  createdAt        DateTime      @default(now())
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([receivedAt])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  status        OutboxStatus @default(pending)
  payload       Json         @default("{}")
  attemptCount  Int          @default(0)
  errorMessage  String?
  lockedAt      DateTime?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
}

/// Configuración del negocio editable desde /admin/settings.
/// Una sola fila (`id = "default"`): no hay multi-sucursal en el MVP.
/// Los defaults reproducen lo que hoy está hardcodeado en el sitio público
/// (ver src/modules/business-settings/domain/business-settings-defaults.ts).
model BusinessSettings {
  id                  String   @id @default("default")
  // Identidad
  name                String   @default("One Burger")
  tagline             String?
  description         String?
  logoUrl             String?
  logoMarkUrl         String?
  faviconUrl          String?
  ogImageUrl          String?
  // Apariencia
  primaryColor        String   @default("#2b6c96")
  accentColor         String   @default("#eaf1f6")
  backgroundColor     String   @default("#fbf9f5")
  foregroundColor     String   @default("#23303a")
  surfaceColor        String   @default("#ffffff")
  headingFont         String   @default("fraunces")
  bodyFont            String   @default("inter")
  // Contacto y ubicación
  phone               String?
  whatsapp            String?
  email               String?
  instagram           String?
  facebook            String?
  tiktok              String?
  addressLine         String?
  city                String?
  addressReference    String?
  mapsUrl             String?
  latitude            Float?
  longitude           Float?
  // Operación
  timezone            String   @default("America/Managua")
  businessHours       Json
  currencyCode        String   @default("NIO")
  currencySymbol      String   @default("C$")
  locale              String   @default("es-NI")
  /// TASK-303a — cuántos de la moneda del negocio vale 1 dólar. `null` = sin tasa cargada.
  usdExchangeRate     Float?
  pickupLeadMinutes   Int      @default(25)
  /// Máximo del rango de preparación (`null` = se promete un instante, no un rango).
  pickupMaxMinutes    Int?
  paymentInstructions String?  @default("Pagás en el local al retirar tu pedido. No se cobra nada online.")
  tipEnabled          Boolean  @default(true)
  tipRate             Int      @default(10)
  /// Tarea 2 del brief (2026-09-17): retiro de caja que se considera «grande». `null` = sin límite.
  /// No hay aprobación del supervisor: marca el movimiento para que se vea, no lo bloquea.
  withdrawalLimit     Float?
  isAcceptingOrders   Boolean  @default(true)
  closedMessage       String?  @default("Estamos cerrados. Podés mirar el menú y volver cuando abramos.")
  // Auditoría
  updatedAt           DateTime @updatedAt
  updatedByUserId     String?
}

/// TASK-103 — un cobro registrado sobre un pedido.
///
/// `Order.paymentMethod` dice **cómo piensa pagar** el cliente (lo declara en el checkout) y no
/// alcanza para operar un mostrador: no registra el monto cobrado, ni la propina del cobro, ni una
/// devolución, ni un pago repartido entre efectivo y tarjeta. Por eso una tabla aparte, y por eso
/// `Order.paymentMethod` se mantiene: la declaración del cliente y el cobro real son dos cosas.
model Payment {
  id        String            @id @default(cuid())
  orderId   String
  method    PaymentMethodType
  amount    Decimal           @db.Decimal(10, 2)
  /// TASK-303b — moneda en la que entró **este** cobro (el cliente puede pagar en dólares).
  /// `null` = la moneda del negocio: un cobro viejo no declara moneda y se cuenta como tal.
  currency  String?
  /// Propina cobrada en este pago. Va aparte del monto porque en un pago mixto puede pagarse sola.
  tip       Decimal           @default(0) @db.Decimal(10, 2)
  /// TASK-305 — vuelto que salió del cajón con este cobro, en la **moneda del negocio**. Es un hecho
  /// del momento (lo que se le devolvió al cliente), y el arqueo lo necesita: sin él, un día con
  /// vueltos parecería que falta plata. El detalle del pedido sigue **derivando** el cambio (T12).
  changeAmount Decimal        @default(0) @db.Decimal(10, 2)
  /// Referencia externa del cobro (número de voucher, id de transferencia). Vacío si no aplica.
  reference String?
  createdAt DateTime          @default(now())
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Bloque 3 del POS — las devoluciones de este cobro. Se guardan para no devolver dos veces la
  /// misma plata: el cupo disponible es `amount` menos las devoluciones no rechazadas.
  refunds   Refund[]

  @@index([orderId])
  @@index([createdAt])
}

/// TASK-104 — un turno de caja: se abre con un fondo, se cierra con el conteo y deja la diferencia.
///
/// Lo que el schema **no** puede declarar, y por eso vive en la migración: un índice único
/// **parcial** que impide dos turnos abiertos en el mismo local a la vez
/// (`UNIQUE ("locationId") WHERE status = 'open'`). El DSL de Prisma no tiene índices parciales, así
/// que la regla se escribe a mano en el SQL; hay un test de contrato que exige que el índice exista,
/// porque sin él dos cajas podrían abrir el mismo turno y el arqueo quedaría partido en dos.
model Shift {
  id             String      @id @default(cuid())
  locationId     String
  userId         String
  status         ShiftStatus @default(open)
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  /// Fondo con el que arranca la caja.
  openingAmount  Decimal     @default(0) @db.Decimal(10, 2)
  /// Lo que se contó al cerrar. `null` mientras el turno está abierto.
  closingAmount  Decimal?    @db.Decimal(10, 2)
  /// Lo que el sistema esperaba según los cobros. Se guarda congelado al cerrar: el arqueo de un
  /// turno cerrado no puede cambiar porque después se editó un pedido.
  expectedAmount Decimal?    @db.Decimal(10, 2)
  /// Bloque 1.1 del POS (Fase 2) — el esperado **por moneda**, tal como se calculó al cerrar
  /// (`{"NIO": 1200, "USD": 40}`). Antes viajaba solo en la respuesta: recomputar un cierre viejo
  /// usaba la tasa de cambio de hoy y mostraba un número que nunca existió.
  expectedByCurrency Json?
  /// Bloque 1.2 del POS (Fase 2) — lo que entró **en efectivo** en el turno, en la moneda del
  /// negocio (monto + propina − vuelto). La tarjeta no entra: no pasó por el cajón.
  cashSalesAmount Decimal?   @db.Decimal(10, 2)
  /// Tarea 1.2 del roadmap + decisión del owner (2026-09-17) — el **desglose por medio de pago** del turno,
  /// congelado al cerrar junto con el arqueo. Antes solo se guardaba el efectivo: la plata de la tarjeta y
  /// de la transferencia no quedaba en ningún lado del turno (había que recomputarla de los cobros).
  cardSalesAmount     Decimal? @db.Decimal(10, 2)
  transferSalesAmount Decimal? @db.Decimal(10, 2)
  /// Mixto y otro: entró, pero no es efectivo ni una tarjeta de la terminal.
  otherSalesAmount    Decimal? @db.Decimal(10, 2)
  /// Propinas del turno. Van **dentro** de cada medio (es plata que el cliente pagó); acá quedan como
  /// detalle, para no tener que sumarlas de los cobros.
  tipsAmount          Decimal? @db.Decimal(10, 2)
  /// Bloque 2 del POS (Fase 2) — el neto de los movimientos del turno (retiros restan, ingresos
  /// suman), en la moneda del negocio. Congelado al cerrar, igual que el resto del arqueo.
  cashMovementsAmount Decimal? @db.Decimal(10, 2)
  /// Bloque 3 del POS (Fase 2) — el neto de las devoluciones en efectivo aprobadas del turno, en la
  /// moneda del negocio (negativo o 0). Congelado al cerrar, igual que el resto del arqueo.
  refundsAmount  Decimal?    @db.Decimal(10, 2)
  /// `closingAmount - expectedAmount`. Negativo = faltó plata.
  difference     Decimal?    @db.Decimal(10, 2)
  /// Bloque 1.10 del POS (Fase 2) — reapertura de un turno cerrado. Queda firmado quién, cuándo y
  /// por qué: reabrir una caja ya cerrada es la operación más sensible del arqueo, y una reapertura
  /// sin motivo escrito no se puede auditar.
  reopenedAt     DateTime?
  reopenedByUserId String?
  reopenReason   String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  location       Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user           AdminUser   @relation(fields: [userId], references: [id], onDelete: Restrict)
  cashCounts     ShiftCashCount[]
  movements      CashMovement[]
  /// Bloque 3 del POS — las devoluciones registradas en este turno. Solo las **aprobadas** y **en
  /// efectivo** restan del esperado: son las que sacaron plata del cajón.
  refunds        Refund[]
  /// Tarea 7 del brief (2026-09-17) — los traspasos de esta caja (Bloque 1.13).
  handovers      ShiftHandover[]

  @@index([locationId, status])
  @@index([userId])
  @@index([openedAt])
}

/// TASK-305 — con qué billetes se abrió y con qué se cerró, **por moneda**.
///
/// El owner lo pidió así: el arqueo no es un número, es un conteo (10 × C$100, 4 × US$20). Guardar
/// las denominaciones permite reconstruir la suma, volver a contar y ver de dónde salió la
/// diferencia; un total suelto no dice nada.
enum ShiftCountKind {
  opening
  closing
}

model ShiftCashCount {
  id           String          @id @default(cuid())
  shiftId      String
  kind         ShiftCountKind
  /// Código ISO de la moneda contada (`NIO`, `USD`): la caja puede tener las dos.
  currency     String
  denomination Decimal         @db.Decimal(10, 2)
  quantity     Int
  createdAt    DateTime        @default(now())
  shift        Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  /// Una sola fila por billete y por tipo de conteo: contar dos veces el mismo billete es un error de
  /// carga, no un dato.
  @@unique([shiftId, kind, currency, denomination])
  @@index([shiftId, kind])
}

/// Tarea 7 del brief (2026-09-17) — el **traspaso de caja entre cajeros** (1.13).
///
/// El turno tiene un solo responsable (`Shift.userId`, quien abrió) y el local no admite dos cajas abiertas
/// a la vez: cuando el cajero se va, la caja **no se cierra**, se traspasa. Cada fila es la firma de un
/// traspaso con el **corte X** de ese momento (`expectedAmount`), congelado igual que el arqueo del
/// cierre: recalcularlo después —con la tasa de cambio de hoy o con cobros que entraron más tarde— diría
/// un número que nadie firmó.
model ShiftHandover {
  id             String   @id @default(cuid())
  shiftId        String
  locationId     String
  /// Quién entrega (usuario del panel). `null` si no se pudo resolver: el nombre queda igual.
  handedByUserId String?
  handedByName   String?
  /// Quién recibe, tal como se firmó. Texto libre: el que sigue no siempre tiene usuario del panel.
  receivedByName String
  /// El esperado del corte X al firmar, en la moneda del negocio.
  expectedAmount Decimal  @db.Decimal(10, 2)
  /// El detalle por moneda del mismo momento (`{"NIO": 1500, "USD": 20}`).
  expectedByCurrency Json?
  notes          String?
  createdAt      DateTime @default(now())
  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt])
  @@index([locationId, createdAt])
}

/// Bloque 2 del roadmap del POS (Fase 2) — plata que entra o sale del cajón **sin ser un cobro**.
///
/// Hasta acá el esperado era `fondo + efectivo − vueltos`: si alguien sacaba C$500 para el proveedor,
/// el cierre marcaba faltante y no había forma de explicarlo. Cada movimiento tiene motivo (obligatorio)
/// y responsable, y **afecta el esperado** del turno en el que se registró.
///
/// El `shiftId` es explícito y no se deriva de la ventana de tiempo como en `Payment`: un movimiento
/// lo hace una persona desde una pantalla que ya sabe de qué caja es, así que no hay motivo para
/// adivinar a qué turno pertenece.
model CashMovement {
  id         String             @id @default(cuid())
  shiftId    String
  kind       CashMovementKind
  category   CashMovementCategory
  /// Monto, siempre positivo: el signo lo da el `kind` (retiro resta, ingreso suma).
  amount     Decimal            @db.Decimal(10, 2)
  /// Código ISO de la moneda que se movió (`NIO`, `USD`).
  currency   String
  /// Por qué se movió. Obligatorio: un retiro sin motivo no se puede auditar.
  reason     String
  /// Quién lo registró.
  userId     String
  /// Bloque 2.5/2.6 — aprobación de un movimiento por encima del límite. `null` = no requiere.
  /// Decisión del owner (2026-09-17): **no hay aprobación del supervisor**, así que estos dos quedan
  /// en `null`; el límite marca el movimiento (`withdrawalLimitAmount`) para que se vea, no lo bloquea.
  approvedByUserId String?
  approvedAt DateTime?
  /// Tarea 2 del brief (2026-09-17) — el límite de retiro **vigente cuando se registró**. `null` = no
  /// había límite configurado. Se guarda congelado: cambiar el límite después no reescribe la historia
  /// (es la misma regla que el arqueo de un cierre).
  withdrawalLimitAmount Decimal?  @db.Decimal(10, 2)
  createdAt  DateTime           @default(now())
  shift      Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user       AdminUser          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt])
  @@index([userId])
}

/// Bloque 2 del roadmap del POS (Fase 2) — de qué lado va la plata del cajón.
enum CashMovementKind {
  /// Sale del cajón: pago a proveedor, retiro a bóveda, gasto.
  withdrawal
  /// Entra al cajón sin ser una venta: cambio, devolución de un retiro, aporte.
  deposit
}

/// Bloque 2.4 — para qué fue. Cerrada a propósito: una categoría libre no se puede sumar en un reporte.
enum CashMovementCategory {
  supplier
  change_fund
  vault
  expense
  other
}

/// Bloque 3 del roadmap del POS (Fase 2) — una devolución sobre un cobro ya registrado.
///
/// El cobro no se borra ni se edita: devolver plata es un **hecho nuevo** con su motivo, su monto y
/// quién lo firmó. Por eso el cupo de un cobro se calcula sumando sus devoluciones no rechazadas
/// (nunca restando del `Payment`), y por eso la devolución guarda el **medio original** del cobro:
/// una devolución de tarjeta no sale del cajón y no puede descontarse del arqueo.
///
/// El `status` arranca en `pending` cuando quien la pide no tiene permiso de aprobar: nadie firma su
/// propia devolución, así que la cola de aprobaciones es la que le da salida.
model Refund {
  id                String             @id @default(cuid())
  paymentId         String
  orderId           String
  /// Turno donde se registró. `null` = no había caja abierta (el cobro pudo ser de otro momento):
  /// la devolución vale igual, solo que no entra a ningún arqueo.
  shiftId           String?
  kind              RefundKind
  /// Medio original del cobro: solo `cash` saca plata del cajón.
  method            PaymentMethodType
  /// Monto, siempre positivo: lo que se le devuelve al cliente. El signo lo pone el arqueo.
  amount            Decimal            @db.Decimal(10, 2)
  /// Código ISO de la moneda devuelta (`NIO`, `USD`): devolver US$20 no resta 20 córdobas.
  currency          String
  /// Por qué se devolvió. Obligatorio: una devolución sin motivo no se puede auditar.
  reason            String
  status            RefundStatus       @default(pending)
  requestedByUserId String?
  approvedByUserId  String?
  approvedAt        DateTime?
  createdAt         DateTime           @default(now())
  payment           Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shift             Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  /// Todas las devoluciones de un cobro: es lo que se suma para saber cuánto queda por devolver.
  @@index([paymentId])
  /// Todas las devoluciones de un pedido (el detalle y la bandeja las muestran juntas).
  @@index([orderId])
  /// Las aprobadas de un turno, que son las que restan del esperado.
  @@index([shiftId, status])
  /// La cola de la bandeja de aprobaciones: lo que está sin resolver, lo más viejo primero.
  @@index([status, createdAt])
}

/// Bloque 3 del POS — si la devolución cubre todo el cobro o solo una parte.
enum RefundKind {
  full
  partial
}

/// Bloque 3 del POS — el estado de una devolución: sin aprobar, aprobada o rechazada.
///
/// Una **rechazada** no consume cupo del cobro (esa plata no salió) pero se conserva: es el registro
/// de que alguien la pidió y otro dijo que no.
enum RefundStatus {
  pending
  approved
  rejected
}



/// Bloque 13.1 del roadmap del POS (Fase 2) — el asiento de una acción sensible.
///
/// Lo que queda en las tablas es el **estado**: que un turno se cerró con una diferencia, que una
/// devolución quedó aprobada. Quién lo hizo, cuándo y con qué motivo es lo que este log agrega, y es la
/// única forma de responder "¿quién reabrió esta caja?" seis meses después. `action` es una lista
/// cerrada del dominio (un texto libre no se puede agrupar); `actorUserId` guarda el id aunque el
/// usuario se borre después, porque el asiento no se puede perder.
model AdminAuditLog {
  id          String   @id @default(cuid())
  action      String
  actorUserId String
  targetType  String
  targetId    String
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([actorUserId, createdAt])
}

/// Alertas al dueño por Telegram (una sola fila, `id = "default"`, como `BusinessSettings`).
///
/// El **token del bot no vive acá**: es del SaaS y va por entorno (`TELEGRAM_BOT_TOKEN`), nunca en la
/// base ni en el repo. Lo que el negocio configura es **su** grupo (`chatId`) y **cuáles** eventos quiere
/// recibir (`eventsEnabled`, lista cerrada del dominio): todos los eventos del sistema se registran en
/// el outbox igual, y esta configuración decide cuáles se reenvían.
model NotificationSettings {
  id       String  @id @default("default")
  /// Grupo/canal de Telegram del negocio. `null` = sin configurar.
  chatId   String?
  enabled  Boolean @default(false)
  /// Claves de `TELEGRAM_EVENTS` que el owner quiere recibir. Por defecto, el cierre de cada turno
  /// (decisión del owner, 2026-09-17): es el aviso de operación normal; los de problema se prenden a mano.
  eventsEnabled Json @default("[\"shift_closed\"]")
  /// Devolución que supera este monto avisa al dueño (decisión del owner: C$500).
  refundAlertThreshold     Float  @default(500)
  /// Diferencia de caja que supera este monto avisa. `null` = no avisar (lo decide el owner).
  differenceAlertThreshold Float?

  lastSentAt DateTime?
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}