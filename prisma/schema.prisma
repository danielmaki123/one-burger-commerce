generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  owner
  manager
  kitchen
  /// TASK-105 — cobra en el punto de venta. No administra menú, promociones ni configuración.
  cashier
}

model AdminUser {
  id           String              @id @default(cuid())
  name         String
  email        String              @unique
  passwordHash String
  role         AdminRole
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sessions     AdminSession[]
  locations    AdminUserLocation[]
  /// TASK-104 — los turnos de caja que abrió y cerró este usuario.
  shifts       Shift[]
}

/// Sucursales que puede ver un usuario del staff (A). El `owner` ve todas y su asignación se
/// ignora; un gerente o cocina **sin filas acá** también ve todas (el deploy no deja a nadie
/// ciego). Borrar el local o el usuario borra la asignación en cascada.
model AdminUserLocation {
  adminUserId String
  locationId  String
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([adminUserId, locationId])
  @@index([locationId])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id                 String            @id @default(cuid())
  fullName           String?
  whatsappNormalized String            @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  orders             Order[]
  reservations       Reservation[]
  addresses          CustomerAddress[]
  sessions           CustomerSession[]
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String?
  address    String
  reference  String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isDefault])
}

model CustomerOtp {
  id                 String    @id @default(cuid())
  whatsappNormalized String
  codeHash           String
  expiresAt          DateTime
  attempts           Int       @default(0)
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([whatsappNormalized, createdAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  /// Color de la categoría en la carta pública (`#rrggbb`). Vacío = sin color.
  color         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  slug       String
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Product {
  id                 String                 @id @default(cuid())
  categoryId         String
  subcategoryId      String?
  name               String
  description        String?
  basePrice          Decimal                @db.Decimal(10, 2)
  packagingFeeAmount Decimal?               @db.Decimal(10, 2)
  sortOrder          Int                    @default(0)
  isAvailable        Boolean                @default(true)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  category           Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory        Subcategory?           @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  modifierGroups     ProductModifierGroup[]
  bundleRules        BundleRule[]
  locations          LocationProduct[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive])
}

/// Un local del negocio (T8). Lo que es por local: dónde se retira, contacto, horario,
/// minutos de preparación y si acepta pedidos. La marca, la moneda y las promos siguen
/// siendo del negocio entero y viven en `BusinessSettings`.
model Location {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  isActive          Boolean             @default(true)
  /// Orden manual; el primero activo es el local por defecto.
  sortOrder         Int                 @default(0)
  addressLine       String?
  city              String?
  addressReference  String?
  mapsUrl           String?
  latitude          Float?
  longitude         Float?
  phone             String?
  whatsapp          String?
  businessHours     Json
  pickupLeadMinutes Int                 @default(25)
  /// Máximo del rango de preparación (`null` = se promete un instante, no una franja).
  pickupMaxMinutes  Int?
  /// B5: minutos que puede esperar un pedido **sin aceptar** antes de avisar en el tablero de comandas.
  acceptAlertMinutes Int                @default(10)
  /// B5: minutos que puede estar un pedido **en cocina** (aceptado, preparando o listo) antes de avisar.
  prepAlertMinutes   Int                @default(15)
  isAcceptingOrders Boolean             @default(true)
  closedMessage     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  products          LocationProduct[]
  orders            Order[]
  adminUsers        AdminUserLocation[]
  /// TASK-104 — los turnos de caja de este local.
  shifts            Shift[]

  @@index([isActive, sortOrder])
}

/// Qué ofrece cada local y a qué precio (T8). Sin fila acá, el producto no se vende en
/// ese local; `priceOverride` en `null` significa "el precio base del producto".
model LocationProduct {
  id            String   @id @default(cuid())
  locationId    String
  productId     String
  priceOverride Decimal? @db.Decimal(10, 2)
  isAvailable   Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ModifierGroup {
  id            String                 @id @default(cuid())
  name          String
  isRequired    Boolean                @default(false)
  minSelections Int                    @default(0)
  maxSelections Int                    @default(1)
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  options       ModifierOption[]
  products      ProductModifierGroup[]
}

model ModifierOption {
  id              String        @id @default(cuid())
  modifierGroupId String
  name            String
  priceDelta      Decimal       @db.Decimal(10, 2)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
}

model ProductModifierGroup {
  id              String        @id @default(cuid())
  productId       String
  modifierGroupId String
  sortOrder       Int           @default(0)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@index([productId])
  @@index([modifierGroupId])
}

model BundleRule {
  id        String   @id @default(cuid())
  productId String
  name      String
  ruleType  String   @default("fixed")
  config    Json     @default("{}")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum MenuMarketingBlockType {
  promo
  event
  combo
  featured
  info
}

enum MenuMarketingBlockCtaType {
  none
  product
  category
  url
}

model MenuMarketingBlock {
  id          String                    @id @default(cuid())
  type        MenuMarketingBlockType
  title       String
  description String?
  imageUrl    String?
  ctaLabel    String?
  ctaType     MenuMarketingBlockCtaType @default(none)
  ctaTarget   String?
  isActive    Boolean                   @default(true)
  sortOrder   Int                       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

enum OrderType {
  delivery
  pickup
  table
}

/// Cómo piensa pagar el cliente (T11). El cobro sigue siendo en el local.
enum PaymentMethod {
  cash
  card
}

/// TASK-103 — los métodos que acepta un **cobro registrado**. Es más amplio que `PaymentMethod`
/// (que declara el cliente en el checkout y sigue existiendo por compatibilidad): acá entran la
/// transferencia, el pago mixto y "otro", que son cosas que pasan en el mostrador.
enum PaymentMethodType {
  cash
  card
  transfer
  mixed
  other
}

/// TASK-104 — un turno de caja, abierto y cerrado.
enum ShiftStatus {
  open
  closed
}

enum OrderStatus {
  new
  confirmed
  preparing
  ready
  out_for_delivery
  delivered
  closed
  ready_for_pickup
  picked_up
  accepted
  served
  cancelled
}

enum CouponType {
  percentage
  fixed_amount
  /// Promo por cantidad (T9): usá `buyQuantity` y `freeQuantity`.
  bogo
}

model Table {
  id           String        @id @default(cuid())
  label        String
  qrToken      String        @unique
  isActive     Boolean       @default(true)
  locationId   String        @default("main")
  capacity     Int           @default(4)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  reservations Reservation[]
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  value        Decimal    @db.Decimal(10, 2)
  isActive     Boolean    @default(true)
  usageLimit   Int        @default(0)
  usedCount    Int        @default(0)
  expiresAt    DateTime?
  /// Promo por cantidad (T9): cuántas unidades hay que llevar y cuántas salen gratis.
  buyQuantity  Int?
  freeQuantity Int?
  /// A qué alcanza: `all`, `category`, `subcategory` o `product`, con su id.
  scopeType    String?    @default("all")
  scopeId      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
}

model DeliveryZone {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  baseFee     Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id                   String               @id @default(cuid())
  orderNumber          String               @unique
  /// Local al que va el pedido (T8). Obligatorio: la migración backfillea los pedidos
  /// que ya existían al local primario.
  locationId           String
  orderLookupTokenHash String?
  /// TASK-101: clave de operación del cliente. El alta pública no tiene sesión, así que un
  /// reintento del mismo request (doble tap, red que se corta) creaba **otro pedido**. Nullable
  /// porque los pedidos que ya existían y los que llegan sin clave no tienen ninguna.
  idempotencyKey       String?              @unique
  type                 OrderType
  status               OrderStatus          @default(new)
  customerName         String
  customerWhatsapp     String
  customerId           String?
  address              String?
  deliveryNotes        String?
  deliveryFeeStatus    String?              @default("pending_manual_validation")
  deliveryFeeAmount    Decimal              @default(0) @db.Decimal(10, 2)
  pickupTime           DateTime?
  /// Si el cliente programó el retiro. `false` = lo antes posible: el servidor guarda
  /// igual una `pickupTime` concreta (ahora + preparación) para que la cocina sepa para
  /// cuándo es, pero la distinción se conserva para poder marcarlo en el admin.
  pickupScheduled      Boolean              @default(false)
  pickupNotes          String?
  tableId              String?
  /// Forma de pago declarada por el cliente (informativa para la caja).
  paymentMethod        PaymentMethod        @default(cash)
  /// Con cuánto paga el cliente, para calcular el vuelto en la caja (T12).
  paidWithAmount       Decimal?             @db.Decimal(10, 2)
  /// Código corto para dictar en caja (T13). No identifica ni autoriza: eso es
  /// `orderNumber` + `orderLookupTokenHash`.
  pickupPin            String?
  couponId             String?
  couponCode           String?
  subtotal             Decimal              @db.Decimal(10, 2)
  discount             Decimal              @default(0) @db.Decimal(10, 2)
  packagingAmount      Decimal              @default(0) @db.Decimal(10, 2)
  tipAmount            Decimal              @default(0) @db.Decimal(10, 2)
  tipRate              Decimal?             @db.Decimal(5, 2)
  total                Decimal              @db.Decimal(10, 2)
  deliveryZoneId       String?
  customerLat          Decimal?             @db.Decimal(10, 8)
  customerLng          Decimal?             @db.Decimal(10, 8)
  geoAccuracy          Float?
  geoCapturedAt        DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  table                Table?               @relation(fields: [tableId], references: [id], onDelete: SetNull)
  location             Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  coupon               Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  customer             Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryZone         DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  /// TASK-103 — los cobros registrados de este pedido (uno por pago; el mixto tiene varios).
  payments             Payment[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([locationId])
  @@index([pickupTime])
  @@index([tableId])
  @@index([couponId])
  @@index([customerId])
  @@index([deliveryZoneId])
}

model OrderItem {
  id                   String              @id @default(cuid())
  orderId              String
  productId            String
  productName          String
  quantity             Int
  unitPrice            Decimal             @db.Decimal(10, 2)
  packagingUnitAmount  Decimal             @default(0) @db.Decimal(10, 2)
  packagingQuantity    Int                 @default(0)
  packagingTotalAmount Decimal             @default(0) @db.Decimal(10, 2)
  notes                String?
  lineTotal            Decimal             @db.Decimal(10, 2)
  createdAt            DateTime            @default(now())
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers            OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemModifier {
  id               String    @id @default(cuid())
  orderItemId      String
  modifierOptionId String
  name             String
  priceDelta       Decimal   @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  /// B5: quién hizo el cambio (id del usuario del panel). Sin FK a propósito: borrar una cuenta no
  /// puede borrar ni romper el historial de lo que pasó con los pedidos.
  changedByUserId String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

enum ReservationStatus {
  requested
  approved
  rejected
  seated
  cancelled
  no_show
}

model Reservation {
  id                         String            @id @default(cuid())
  status                     ReservationStatus @default(requested)
  customerName               String
  customerWhatsapp           String
  customerId                 String?
  reservationNumber          String?           @unique
  reservationLookupTokenHash String?
  date                       String
  time                       String
  partySize                  Int
  tableId                    String
  tableLabel                 String
  notes                      String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  table                      Table             @relation(fields: [tableId], references: [id])
  customer                   Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([date])
  @@index([tableId])
  @@index([customerId])
}

enum OutboxStatus {
  pending
  processing
  processed
  failed
}

model InventoryItem {
  id                    String                   @id @default(cuid())
  name                  String
  unit                  String
  category              String
  currentEstimatedStock Decimal                  @db.Decimal(10, 3)
  lowStockThreshold     Decimal                  @db.Decimal(10, 3)
  isActive              Boolean                  @default(true)
  locationId            String                   @default("main")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  counts                InventoryCount[]
  wasteRecords          InventoryWasteRecord[]
  receiveRecords        InventoryReceiveRecord[]

  @@index([isActive])
  @@index([locationId])
}

model InventoryCount {
  id              String        @id @default(cuid())
  inventoryItemId String
  countedQuantity Decimal       @db.Decimal(10, 3)
  countedByUserId String
  countedAt       DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([countedAt])
}

model InventoryWasteRecord {
  id               String        @id @default(cuid())
  inventoryItemId  String
  quantity         Decimal       @db.Decimal(10, 3)
  reason           String
  reportedByUserId String
  reportedAt       DateTime      @default(now())
  notes            String?
  createdAt        DateTime      @default(now())
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([reportedAt])
}

model InventoryReceiveRecord {
  id               String        @id @default(cuid())
  inventoryItemId  String
  receivedQuantity Decimal       @db.Decimal(10, 3)
  receivedByUserId String
  receivedAt       DateTime      @default(now())
  notes            String?
  createdAt        DateTime      @default(now())
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([receivedAt])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  status        OutboxStatus @default(pending)
  payload       Json         @default("{}")
  attemptCount  Int          @default(0)
  errorMessage  String?
  lockedAt      DateTime?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
}

/// Configuración del negocio editable desde /admin/settings.
/// Una sola fila (`id = "default"`): no hay multi-sucursal en el MVP.
/// Los defaults reproducen lo que hoy está hardcodeado en el sitio público
/// (ver src/modules/business-settings/domain/business-settings-defaults.ts).
model BusinessSettings {
  id                  String   @id @default("default")
  // Identidad
  name                String   @default("One Burger")
  tagline             String?
  description         String?
  logoUrl             String?
  logoMarkUrl         String?
  faviconUrl          String?
  ogImageUrl          String?
  // Apariencia
  primaryColor        String   @default("#2b6c96")
  accentColor         String   @default("#eaf1f6")
  backgroundColor     String   @default("#fbf9f5")
  foregroundColor     String   @default("#23303a")
  surfaceColor        String   @default("#ffffff")
  headingFont         String   @default("fraunces")
  bodyFont            String   @default("inter")
  // Contacto y ubicación
  phone               String?
  whatsapp            String?
  email               String?
  instagram           String?
  facebook            String?
  tiktok              String?
  addressLine         String?
  city                String?
  addressReference    String?
  mapsUrl             String?
  latitude            Float?
  longitude           Float?
  // Operación
  timezone            String   @default("America/Managua")
  businessHours       Json
  currencyCode        String   @default("NIO")
  currencySymbol      String   @default("C$")
  locale              String   @default("es-NI")
  /// TASK-303a — cuántos de la moneda del negocio vale 1 dólar. `null` = sin tasa cargada.
  usdExchangeRate     Float?
  pickupLeadMinutes   Int      @default(25)
  /// Máximo del rango de preparación (`null` = se promete un instante, no un rango).
  pickupMaxMinutes    Int?
  paymentInstructions String?  @default("Pagás en el local al retirar tu pedido. No se cobra nada online.")
  tipEnabled          Boolean  @default(true)
  tipRate             Int      @default(10)
  isAcceptingOrders   Boolean  @default(true)
  closedMessage       String?  @default("Estamos cerrados. Podés mirar el menú y volver cuando abramos.")
  // Auditoría
  updatedAt           DateTime @updatedAt
  updatedByUserId     String?
}

/// TASK-103 — un cobro registrado sobre un pedido.
///
/// `Order.paymentMethod` dice **cómo piensa pagar** el cliente (lo declara en el checkout) y no
/// alcanza para operar un mostrador: no registra el monto cobrado, ni la propina del cobro, ni una
/// devolución, ni un pago repartido entre efectivo y tarjeta. Por eso una tabla aparte, y por eso
/// `Order.paymentMethod` se mantiene: la declaración del cliente y el cobro real son dos cosas.
model Payment {
  id        String            @id @default(cuid())
  orderId   String
  method    PaymentMethodType
  amount    Decimal           @db.Decimal(10, 2)
  /// Propina cobrada en este pago. Va aparte del monto porque en un pago mixto puede pagarse sola.
  tip       Decimal           @default(0) @db.Decimal(10, 2)
  /// Referencia externa del cobro (número de voucher, id de transferencia). Vacío si no aplica.
  reference String?
  createdAt DateTime          @default(now())
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

/// TASK-104 — un turno de caja: se abre con un fondo, se cierra con el conteo y deja la diferencia.
///
/// Lo que el schema **no** puede declarar, y por eso vive en la migración: un índice único
/// **parcial** que impide dos turnos abiertos en el mismo local a la vez
/// (`UNIQUE ("locationId") WHERE status = 'open'`). El DSL de Prisma no tiene índices parciales, así
/// que la regla se escribe a mano en el SQL; hay un test de contrato que exige que el índice exista,
/// porque sin él dos cajas podrían abrir el mismo turno y el arqueo quedaría partido en dos.
model Shift {
  id             String      @id @default(cuid())
  locationId     String
  userId         String
  status         ShiftStatus @default(open)
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  /// Fondo con el que arranca la caja.
  openingAmount  Decimal     @default(0) @db.Decimal(10, 2)
  /// Lo que se contó al cerrar. `null` mientras el turno está abierto.
  closingAmount  Decimal?    @db.Decimal(10, 2)
  /// Lo que el sistema esperaba según los cobros. Se guarda congelado al cerrar: el arqueo de un
  /// turno cerrado no puede cambiar porque después se editó un pedido.
  expectedAmount Decimal?    @db.Decimal(10, 2)
  /// `closingAmount - expectedAmount`. Negativo = faltó plata.
  difference     Decimal?    @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  location       Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user           AdminUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([locationId, status])
  @@index([userId])
  @@index([openedAt])
}


