# Local development: use the URL below only when a local PostgreSQL is available.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneburger?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/oneburger?schema=public"
NODE_ENV="development"
APP_ENV="dev"
PORT="3000"

# External integrations foundation (TASK-012)
# Keep these values empty/false by default in local repo.
NOTIFICATIONS_DRIVER="dummy"
TELEGRAM_NOTIFICATIONS_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
N8N_WEBHOOK_BASE_URL=""
SUPABASE_MCP_MODE="read_only_dev"
LINEAR_MODE="disabled"

# Deployment preparation (TASK-013)
# Never commit real credentials. Use staging/prod values only in platform secret manager.
STAGING_DATABASE_URL=""
STAGING_DIRECT_URL=""
PROD_DATABASE_URL=""
PROD_DIRECT_URL=""
NEXTAUTH_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
N8N_WEBHOOK_SECRET=""

# Easypanel production deploy
# Use rotated credentials only. Do not reuse tokens pasted in chat.
EASYPANEL_URL="https://<panel-domain>"
EASYPANEL_TOKEN=""
EASYPANEL_PROJECT_NAME="oneburguer"
EASYPANEL_APP_SERVICE_NAME="web"
EASYPANEL_POSTGRES_SERVICE_NAME="postgres"
EASYPANEL_POSTGRES_DB="oneburguer"
EASYPANEL_POSTGRES_USER="oneburguer"
EASYPANEL_POSTGRES_PASSWORD=""
EASYPANEL_GITHUB_OWNER="danielmaki123"
EASYPANEL_GITHUB_REPO="one-burger-commerce"
EASYPANEL_GITHUB_REF="main"
EASYPANEL_GITHUB_PATH="/"
EASYPANEL_CREATE_DOMAIN="false"
EASYPANEL_DOMAIN_HOST=""

# Staging persistent admin bootstrap (TASK-019E)
# Required for POST /api/internal/staging/persistent-admin
STAGING_ADMIN_QA_TOKEN=""
STAGING_ADMIN_EMAIL=""
STAGING_ADMIN_PASSWORD=""
STAGING_ADMIN_NAME="Daniel Chavarria"
STAGING_ADMIN_ROLE="owner"
