# Local development: use the URL below only when a local PostgreSQL is available.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneburger?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/oneburger?schema=public"
NODE_ENV="development"
APP_ENV="dev"
PORT="3000"

# Startup validation (scripts/start-production.mjs)
# MIGRATIONS_AUTO=false makes the container skip `prisma migrate deploy` so the
# migration step can be run and verified as an explicit deploy step.
MIGRATIONS_AUTO="true"
MIGRATION_MAX_ATTEMPTS="12"
MIGRATION_RETRY_DELAY_MS="5000"

# Reverse proxy trust (rate limiting reads x-real-ip / the last x-forwarded-for hop)
# Optional extra admin hosts for root redirects, comma separated.
# Any "admin.<domain>" host is recognised without configuration.
ADMIN_HOSTS=""

# Attempts per minute per IP for the admin login (default 10). Staff usually
# share one public IP, so keep room for a shift change while braking brute force.
ADMIN_LOGIN_RATE_LIMIT="10"

# Notifications (outbox)
# "dummy" discards every notification. Use a real channel in production.
# `telegram_alerts` = alertas del negocio (Parte 3 del brief): el **token del bot es del SaaS** y va acá;
# el chat_id, los eventos y los umbrales los configura el dueño en /admin/settings/notifications.
NOTIFICATIONS_DRIVER="dummy"
TELEGRAM_NOTIFICATIONS_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_TIMEOUT_MS="5000"
N8N_WEBHOOK_BASE_URL=""
N8N_WEBHOOK_SECRET=""
N8N_TIMEOUT_MS="5000"
OUTBOX_PROCESSOR_ENABLED="false"
OUTBOX_PROCESSOR_SECRET=""
OUTBOX_PROCESSOR_BATCH_SIZE="20"
OUTBOX_PROCESSOR_MAX_ATTEMPTS="5"
OUTBOX_PROCESSOR_ALLOWED_EVENT_TYPES=""
OUTBOX_PROCESSOR_MIN_CREATED_AT=""
OUTBOX_PROCESSOR_SCHEDULE_MS="15000"
OUTBOX_PROCESSOR_INTERNAL_URL=""

# Customer OTP (no production provider configured yet)
# These two switches are staging-only: with them on, OTP codes are logged in clear text.
CUSTOMER_OTP_DEV_LOG="false"
CUSTOMER_OTP_STAGING_SMOKE_MODE="false"

# Legacy integrations kept from the source project. Nothing reads these values
# today; they are not required to run the app.
NEXTAUTH_SECRET=""
SUPABASE_MCP_MODE="read_only_dev"
LINEAR_MODE="disabled"

# Deployment preparation (TASK-013)
# Never commit real credentials. Use staging/prod values only in platform secret manager.
STAGING_DATABASE_URL=""
STAGING_DIRECT_URL=""
PROD_DATABASE_URL=""
PROD_DIRECT_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# Easypanel production deploy
# Use rotated credentials only. Do not reuse tokens pasted in chat.
EASYPANEL_URL="https://<panel-domain>"
EASYPANEL_TOKEN=""
EASYPANEL_PROJECT_NAME="oneburguer"
EASYPANEL_APP_SERVICE_NAME="web"
EASYPANEL_POSTGRES_SERVICE_NAME="postgres"
EASYPANEL_POSTGRES_DB="oneburguer"
EASYPANEL_POSTGRES_USER="oneburguer"
EASYPANEL_POSTGRES_PASSWORD=""
EASYPANEL_DATABASE_HOST=""
EASYPANEL_ALLOW_EXISTING_PROJECT="false"
EASYPANEL_API_BASE=""
EASYPANEL_GITHUB_OWNER="danielmaki123"
EASYPANEL_GITHUB_REPO="one-burger-commerce"
EASYPANEL_GITHUB_REF="main"
EASYPANEL_GITHUB_PATH="/"
EASYPANEL_CREATE_DOMAIN="false"
EASYPANEL_DOMAIN_HOST=""

# First production admin (scripts/bootstrap-admin.ts)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_ROLE="owner"

# Staging internal endpoints (fail closed unless APP_ENV=staging)
# Required for POST /api/internal/staging/persistent-admin
STAGING_ADMIN_QA_TOKEN=""
STAGING_ADMIN_EMAIL=""
STAGING_ADMIN_PASSWORD=""
STAGING_ADMIN_NAME="Daniel Chavarria"
STAGING_ADMIN_ROLE="owner"
STAGING_SEED_RUN_TOKEN=""
STAGING_SEED_CONFIRM=""
STAGING_SEED_CLEANUP_CONFIRM=""
STAGING_SEED_DRY_RUN="false"
STAGING_SEED_CREATE_ADMIN="false"
STAGING_SEED_CREATE_STAFF="false"
STAGING_SEED_SYSTEM_USER_ID=""
